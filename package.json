{
  "name": "drawio-mcp",
  "version": "2.1.0",
  "description": "Draw.io MCP - A monorepo containing the MCP server and browser plugin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "clean": "pnpm -r clean",
    "translate": "node scripts/translate.mjs",
    "translate:check": "node scripts/translate.mjs locales --check",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "check-audit-overrides": "./scripts/check-audit-overrides.sh"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "drawio",
    "diagrams.net"
  ],
  "author": "Ladislav Gazo",
  "license": "MIT",
  "devDependencies": {
    "ts-jest": "29.4.14"
  }
}
